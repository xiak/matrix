{
  "apiVersion": "iam.matrix.xiak.com/v1",
  "kind": "IAMBootstrap",
  "installationId": "installation-example",
  "organization": {
    "id": "organization-example",
    "displayName": "Example Organization"
  },
  "administrator": {
    "id": "principal-admin",
    "loginName": "admin",
