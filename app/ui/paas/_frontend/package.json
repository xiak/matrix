{
  "name": "@matrix/paas-control-plane-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.4",
  "engines": {
    "node": "^20.19.0 || ^22.22.0 || >=24.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:embedded": "npm run build && node scripts/sync-static-export.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:styles": "node scripts/check-styles.mjs",
    "check:embedded": "npm run build && node scripts/check-embedded-export.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:architecture && npm run check:styles && npm run test && npm run check:embedded"
  },
  "dependencies": {
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
