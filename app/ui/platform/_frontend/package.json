{
  "name": "@matrix/platform-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.4",
  "engines": {
    "node": "^22.22.0 || ^24.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/normalize-static-export.mjs",
    "build:embedded": "npm run build && node scripts/sync-static-export.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=2 && node --test scripts/normalize-static-export.test.mjs",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:styles": "node scripts/check-styles.mjs",
    "check:embedded": "npm run build && node scripts/check-embedded-export.mjs",
    "check": "npm run check:contracts && npm run typecheck && npm run lint && npm run check:architecture && npm run check:styles && npm run test && npm run check:embedded",
    "check:contracts": "node scripts/generate-contracts.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "next-intl": "4.14.2",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.27.4"
  }
}
